                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding AddLineCommand}" Content="➕ Thêm dòng" Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="10,6" Margin="0,0,6,0" Cursor="Hand"/>
