                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- GENERAL LEDGER & TRIAL BALANCE WORKSPACE -->
                <Grid DataContext="{Binding GeneralLedger}"
                      Visibility="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleToVis}, ConverterParameter={x:Static vm:AppModule.GeneralLedger}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bảng Cân Đối Phát Sinh &amp; Sổ Cái (General Ledger)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Tổng hợp phát sinh Nợ/Có theo tài khoản từ cơ sở dữ liệu" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding LoadLedgerCommand}" Content="🔄 Nạp Dữ Liệu Sổ Cái (F5)" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1">
