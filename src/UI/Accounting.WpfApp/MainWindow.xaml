                                </Grid.ColumnDefinitions>
                                <!-- UoMs column -->
                                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Đơn Vị Tính (UoM)" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBox Text="{Binding UomCode, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2"/>
                                            <TextBox Text="{Binding UomName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2"/>
                                            <Button Command="{Binding CreateUomCommand}" Content="➕ Thêm ĐVT" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="6,4" Margin="0,4,0,0" Cursor="Hand"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="2" ItemsSource="{Binding UnitsOfMeasure}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="60"/>
                                                <DataGridTextColumn Header="Tên ĐVT" Binding="{Binding Name}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                                <!-- Warehouses column -->
                                <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Danh Mục Kho Hàng" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBox Text="{Binding WarehouseId, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2"/>
                                            <TextBox Text="{Binding WarehouseName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2"/>
                                            <Button Command="{Binding CreateWarehouseCommand}" Content="➕ Thêm Kho Hàng" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="6,4" Margin="0,4,0,0" Cursor="Hand"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="2" ItemsSource="{Binding Warehouses}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Mã Kho" Binding="{Binding Id}" Width="80"/>
                                                <DataGridTextColumn Header="Tên Kho" Binding="{Binding Name}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                                <!-- Currencies column -->
                                <Border Grid.Column="4" Background="#F8FAFC" CornerRadius="6" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Tiền Tệ (Currencies)" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2"/>
                                            <TextBox Text="{Binding CurrencyName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2"/>
                                            <Button Command="{Binding CreateCurrencyCommand}" Content="➕ Thêm Tiền Tệ" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="6,4" Margin="0,4,0,0" Cursor="Hand"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="2" ItemsSource="{Binding Currencies}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="50"/>
                                                <DataGridTextColumn Header="Ký hiệu" Binding="{Binding Symbol}" Width="50"/>
                                                <DataGridTextColumn Header="Tên Tiền Tệ" Binding="{Binding Name}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- 9. PERIOD-END CLOSING WORKSPACE -->
                <Grid DataContext="{Binding PeriodClosing}"
                      Visibility="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleToVis}, ConverterParameter={x:Static vm:AppModule.PeriodEnd}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header card -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Khóa Sổ &amp; Quyết Toán Kỳ Kế Toán (Period-End Closing Engine)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Kiểm tra toàn vẹn 10 quy tắc kế toán, Đánh giá lại tỷ giá ngoại tệ (413/515/635), và Kết chuyển KQKD sang 911/4212" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kỳ thực hiện:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}" Width="40" Padding="4" TextAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="/" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="4" TextAlignment="Center" Margin="0,0,12,0"/>
                                <Button Command="{Binding RunPreClosingChecksCommand}" Content="🔍 Chạy Kiểm Tra Toàn Vẹn" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Command="{Binding ExecutePnLClosingCommand}" Content="⚡ Kết Chuyển KQKD (911/4212)" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Padding="12,8" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FX Revaluation Control Bar -->
                    <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#BFDBFE" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Đánh giá lại ngoại tệ cuối kỳ:" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Ngoại tệ:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding FxCurrency, UpdateSourceTrigger=PropertyChanged}" Width="50" Padding="4" TextAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Tỷ giá chốt cuối kỳ:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding FxClosingRate, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="4" TextAlignment="Right" Margin="0,0,12,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ExecuteFxRevaluationCommand}" Content="💱 Thực Thi Đánh Giá Lại Tỷ Giá" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="12,6" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Health Check Report List -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Báo Cáo Kiểm Tra Toàn Vẹn Trước Khóa Sổ (Pre-Closing Health Check)" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding ErrorCount, StringFormat='{} | Lỗi: {0}'}" FontWeight="Bold" Foreground="#DC2626" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding WarningCount, StringFormat='{} | Cảnh báo: {0}'}" FontWeight="Bold" Foreground="#D97706" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding HealthChecks}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" Background="White" BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Quy Tắc" Binding="{Binding RuleCode}" FontWeight="SemiBold" Width="180"/>
                                    <DataGridTextColumn Header="Tên Quy Tắc Kiểm Tra" Binding="{Binding RuleTitle}" Width="280"/>
                                    <DataGridTextColumn Header="Mức Độ" Binding="{Binding Severity}" Width="90"/>
                                    <DataGridCheckBoxColumn Header="Đạt" Binding="{Binding Passed}" Width="60"/>
                                    <DataGridTextColumn Header="Chi Tiết / Đánh Giá" Binding="{Binding Details}" Width="*"/>
                                    <DataGridTextColumn Header="Số Bản Ghi Lỗi" Binding="{Binding OffendingRecordsCount}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- DASHBOARD WORKSPACE -->
                <Grid Visibility="{Binding CurrentModule, Converter={StaticResource ModuleToVis}, ConverterParameter={x:Static vm:AppModule.Dashboard}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Bàn Làm Việc Kế Toán Doanh Nghiệp" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Tổng quan số liệu thời gian thực theo Chế độ Kế toán TT 99/2025/TT-BTC &amp; TT 89/2026/TT-BTC" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" VerticalAlignment="Top">
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,10" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💰 Số Dư Tiền &amp; Tương Đương Tiền (111, 112)" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CashBalance, StringFormat='{}{0:N0} VND'}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,10" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💼 Phải Thu Khách Hàng (131)" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ReceivablesTotal, StringFormat='{}{0:N0} VND'}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,10,10,0" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🛒 Phải Trả Nhà Cung Cấp (331)" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="{Binding PayablesTotal, StringFormat='{}{0:N0} VND'}" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="10,10,0,0" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📦 Giá Trị Hàng Tồn Kho (15x)" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="{Binding InventoryValue, StringFormat='{}{0:N0} VND'}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Lindy-Engine v10.0 • Production Ready" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- UNIVERSAL SEARCH MODAL OVERLAY (Ctrl+F / F3) -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding UniversalSearch.IsOpen, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="999">
            <Border Background="White" CornerRadius="8" Width="680" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#2563EB" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.3" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🔍 Tra Cứu Toàn Năng (Universal Search)" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Command="{Binding UniversalSearch.SelectResultCommand}" CommandParameter="{x:Null}"
                                Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                FontSize="14" FontWeight="Bold" Foreground="#64748B" Cursor="Hand"/>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding UniversalSearch.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14" BorderBrush="#2563EB" BorderThickness="1.5"
                             Margin="0,0,0,12"/>

                    <ListBox Grid.Row="2" ItemsSource="{Binding UniversalSearch.Results}"
                             BorderBrush="#E2E8F0" BorderThickness="1" MaxHeight="320">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.UniversalSearch.SelectResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding RecordType}" FontSize="11" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Code}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#475569" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='{}{0:N0} đ'}" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="Nhấn vào kết quả để chuyển ngay đến phân hệ và chứng từ tương ứng."
                               FontSize="11" Foreground="#64748B" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
