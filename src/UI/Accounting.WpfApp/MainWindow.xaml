                                <TextBlock Text="Tên Doanh Nghiệp *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,16" BorderBrush="#CBD5E1"/>

                                <TextBlock Text="Địa Chỉ Trụ Sở Chính *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,16" BorderBrush="#CBD5E1"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Người Đại Diện Pháp Luật (Giám đốc) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding LegalRepresentative, UpdateSourceTrigger=PropertyChanged}" Padding="8" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kế Toán Trưởng / Phụ Trách Kế Toán *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ChiefAccountant, UpdateSourceTrigger=PropertyChanged}" Padding="8" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số Điện Thoại Liên Hệ" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" Padding="8" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Cơ Quan Thuế Quản Lý" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding TaxOffice, UpdateSourceTrigger=PropertyChanged}" Padding="8" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding StatusMessage}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

