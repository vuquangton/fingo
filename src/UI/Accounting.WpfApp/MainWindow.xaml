                                    <DataGridTextColumn Header="Mã Số" Binding="{Binding LineCode}" Width="80"/>
                                    <DataGridTextColumn Header="Chỉ Tiêu Báo Cáo" Binding="{Binding ItemName}" Width="*"/>
