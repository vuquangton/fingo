<Window x:Class="Accounting.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Accounting.WpfApp.ViewModels"
        xmlns:conv="clr-namespace:Accounting.WpfApp.Converters"
        mc:Ignorable="d"
        Title="VAS Enterprise Accounting (.NET 10 LTS) - Chế độ kế toán Thông tư 99/2025/TT-BTC &amp; TT 89/2026/TT-BTC"
        Height="850" Width="1350"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_OnKeyDown">
    <Window.Resources>
        <conv:ModuleToVisibilityConverter x:Key="ModuleToVis"/>
    </Window.Resources>
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="56"/>
            <!-- Main Content -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
                        <TextBlock Text="VAS" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="VAS ENTERPRISE ACCOUNTING" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text=".NET 10 LTS • High-Reliability Architecture" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Keyboard shortcuts bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock Foreground="#E2E8F0" FontSize="11">
                            <Bold Foreground="#38BDF8">F2</Bold> Chứng từ mới
                        </TextBlock>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock Foreground="#E2E8F0" FontSize="11">
                            <Bold Foreground="#38BDF8">F5</Bold> Nạp lại (Refresh)
                        </TextBlock>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock Foreground="#E2E8F0" FontSize="11">
                            <Bold Foreground="#34D399">F8</Bold> Ghi sổ (Post)
                        </TextBlock>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock Foreground="#E2E8F0" FontSize="11">
                            <Bold Foreground="#F87171">F9</Bold> Bỏ ghi (Unpost)
                        </TextBlock>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock Foreground="#E2E8F0" FontSize="11">
                            <Bold Foreground="#FBBF24">F12</Bold> Lưu (Save)
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- System Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- DB Provider Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DatabaseProvider}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Fiscal Period Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding FiscalPeriod, StringFormat='Kỳ: {0}'}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <!-- User Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="{Binding CurrentUser}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT: SIDEBAR + WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16">
                        <TextBlock Text="ĐIỀU HƯỚNG CHÍNH" Foreground="#64748B" FontWeight="Bold" FontSize="10" Margin="20,4,20,8"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Dashboard}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Bàn Làm Việc" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Vouchers}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Chứng Từ Kế Toán (F2)" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.GeneralLedger}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Sổ Cái &amp; Cân Đối (GL)" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="PHÂN HỆ NGHIỆP VỤ" Foreground="#64748B" FontWeight="Bold" FontSize="10" Margin="20,16,20,8"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Treasury}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Tiền Mặt &amp; Ngân Hàng" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Purchasing}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Mua Hàng &amp; Phải Trả" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Sales}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Bán Hàng &amp; Phải Thu" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Inventory}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Kho &amp; Tính Giá Vốn" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.FixedAssets}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Tài Sản Cố Định (TSCĐ)" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Payroll}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Lương &amp; Bảo Hiểm" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.StatutoryReports}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Báo Cáo Tài Chính &amp; Thuế" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="#334155" Margin="16,8"/>

                        <!-- FOUNDATION MODULES -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.CompanySetup}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" Fill="#A855F7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Thiết Lập Doanh Nghiệp" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.OpeningBalance}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1.4c0-2 4-3.1 6-3.1s6 1.1 6 3.1V18z" Fill="#F59E0B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Số Dư Đầu Kỳ" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.UserManagement}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Fill="#10B981" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Quản Lý Người Dùng &amp; Quyền" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="#334155" Margin="16,8"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppModule.Settings}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Fill="#64748B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                                <TextBlock Text="Cài Đặt &amp; Nhật Ký Audit" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- WORKSPACE AREA -->
            <Grid Grid.Column="1" Margin="20">
                <!-- VOUCHER ENTRY WORKSPACE -->
                <Grid DataContext="{Binding VoucherEntry}"
                      Visibility="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleToVis}, ConverterParameter={x:Static vm:AppModule.Vouchers}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header card -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chứng Từ Kế Toán Kép (Double-Entry Journal Entry)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Định khoản chuẩn Thông tư 99/2025/TT-BTC • Kiểm tra tức thời Tổng Nợ == Tổng Có" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Balance Badge -->
                            <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding BalanceStatusText}" FontWeight="Bold" FontSize="13" Foreground="#15803D"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Voucher Master Metadata form -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                                <TextBlock Text="Số chứng từ:" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                <TextBox Text="{Binding VoucherNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,0" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                                <TextBlock Text="Ngày chứng từ:" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                <DatePicker SelectedDate="{Binding VoucherDate}" Padding="4" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                                <TextBlock Text="Ngày hạch toán (Posting):" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                <DatePicker SelectedDate="{Binding PostingDate}" Padding="4" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                                <TextBlock Text="Tiền tệ / Tỷ giá:" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                <TextBox Text="{Binding Currency, StringFormat='{}{0} (1.0)'}" Padding="8,6" Margin="0,4,0,0" IsReadOnly="True" Background="#F8FAFC"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="4,8,4,0">
                                <TextBlock Text="Diễn giải chung:" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,0" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Virtualized Voucher Lines Grid -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Command="{Binding SaveVoucherCommand}" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="Lưu Chứng Từ (F12)" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddLineCommand}" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Thêm Dòng" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NewVoucherCommand}" Style="{StaticResource ActionButtonStyle}" Background="#0F172A" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
