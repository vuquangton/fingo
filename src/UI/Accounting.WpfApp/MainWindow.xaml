                                <DataGridTextColumn Header="Phát Sinh Nợ" Binding="{Binding DebitMovement, StringFormat='{}{0:N0}'}" Width="140"/>
                                <DataGridTextColumn Header="Phát Sinh Có" Binding="{Binding CreditMovement, StringFormat='{}{0:N0}'}" Width="140"/>
                                <DataGridTextColumn Header="Dư Cuối Kỳ" Binding="{Binding ClosingBalance, StringFormat='{}{0:N0}'}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- STATUTORY REPORTS & TAX WORKSPACE -->
                <Grid DataContext="{Binding StatutoryReports}"
                      Visibility="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleToVis}, ConverterParameter={x:Static vm:AppModule.StatutoryReports}}">
