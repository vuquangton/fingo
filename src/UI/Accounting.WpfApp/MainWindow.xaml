                                    <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseId}" Width="100"/>
                                    <DataGridTextColumn Header="Đã Khóa Sổ" Binding="{Binding IsCommitted}" Width="90"/>
                                    <DataGridTextColumn Header="Diễn Giải" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Validation Issues List -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="8">
