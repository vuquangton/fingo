                                <Button Command="{Binding PrintVoucherCommand}" Content="🖨️ In Mẫu TT 99 (Ctrl+P)" Background="#059669" Foreground="White" FontWeight="SemiBold" Padding="12,6" Margin="0,0,6,0" Cursor="Hand"/>
