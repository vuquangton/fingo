                                    <TextBlock Text="{Binding TotalDebit, StringFormat='{}Tổng Nợ: {0:N0} đ'}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding TotalCredit, StringFormat='{}Tổng Có: {0:N0} đ'}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding Difference, StringFormat='{}Chênh lệch: {0:N0} đ'}" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding LoadOpeningBalancesCommand}" Content="🔄 Nạp Số Dư" Background="#F1F5F9" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Command="{Binding ValidateBalancesCommand}" Content="🔍 Kiểm Tra Đối Soát (4 Chiều)" Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Command="{Binding CommitBalancesCommand}" Content="🔒 Khóa Sổ Đầu Kỳ (Tạo PKT)" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Padding="14,8" Cursor="Hand"/>
                            </StackPanel>
