                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Voucher Lines DataGrid -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,16,0,0" BorderBrush="#CBD5E1" BorderThickness="1">
