                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding LoadB01ReportCommand}" Content="📊 Bảng Cân Đối Kế Toán (B01-DN)" Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Command="{Binding LoadB02ReportCommand}" Content="📈 Báo Cáo KQHĐKD (B02-DN)" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Command="{Binding GenerateTaxXmlCommand}" Content="📑 Xuất Tờ Khai Thuế XML (HTKK 01/GTGT)" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Padding="12,8" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
