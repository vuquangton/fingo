                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Grid.Row="1" Text="{Binding XmlPreview}" Height="150" Margin="0,10,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" FontFamily="Consolas" FontSize="11"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- COMPANY SETUP WORKSPACE -->
                <Grid DataContext="{Binding CompanySetup}"
                      Visibility="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleToVis}, ConverterParameter={x:Static vm:AppModule.CompanySetup}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hồ Sơ Doanh Nghiệp (Company Profile)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Thông tin pháp lý chính thức phục vụ tiêu đề chứng từ, sổ sách và tờ khai thuế HTKK" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding LoadCompanySettingCommand}" Content="🔄 Nạp lại" Background="#F1F5F9" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Command="{Binding SaveCompanySettingCommand}" Content="💾 Lưu Cấu Hình" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="16,8" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="24" BorderBrush="#CBD5E1" BorderThickness="1">
