                                    <DataGridTextColumn Header="Dư Nợ" Binding="{Binding DebitAmount, StringFormat='{}{0:N0}'}" Width="140"/>
                                    <DataGridTextColumn Header="Dư Có" Binding="{Binding CreditAmount, StringFormat='{}{0:N0}'}" Width="140"/>
