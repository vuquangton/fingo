                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- TK Có In-Grid Lookup -->
                                    <DataGridTemplateColumn Header="TK Có (Credit)" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ctrl:InGridLookupControl SearchText="{Binding CreditAccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          LookupEngine="{Binding DataContext.AccountLookup, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Số Tiền (Amount)" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="160"/>
                                    <DataGridTextColumn Header="Diễn Giải Chi Tiết" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTemplateColumn Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Xóa" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" Padding="6,2" Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Footer Totals Card -->
                    <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tổng cộng phát sinh:" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="Tổng Nợ: " Foreground="#94A3B8" VerticalAlignment="Center"/>
