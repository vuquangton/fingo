<UserControl x:Class="Accounting.WpfApp.Controls.InGridLookupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="150">
    <Grid>
        <TextBox x:Name="SearchTextBox"
                 Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="SearchTextBox_TextChanged"
                 PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                 LostFocus="SearchTextBox_LostFocus"
                 Padding="6,4"
                 VerticalContentAlignment="Center"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"
                 Background="White"/>

        <Popup x:Name="LookupPopup"
               PlacementTarget="{Binding ElementName=SearchTextBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">
            <Border Background="White"
                    BorderBrush="#2563EB"
                    BorderThickness="1"
                    CornerRadius="4"
                    MaxHeight="260"
                    Width="380"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25" ShadowDepth="3"/>
                </Border.Effect>
                <ListBox x:Name="ResultsListBox"
                         ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         PreviewKeyDown="ResultsListBox_PreviewKeyDown"
                         MouseDoubleClick="ResultsListBox_MouseDoubleClick"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="Bold" Foreground="#2563EB"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#0F172A" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding ExtraInfo}" Foreground="#64748B" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
