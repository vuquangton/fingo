<Window x:Class="Accounting.WpfApp.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.WpfApp.Views"
        xmlns:viewmodels="clr-namespace:Accounting.WpfApp.ViewModels"
        mc:Ignorable="d"
        Title="Thiết lập hệ thống" Height="700" Width="1000" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrandSurfaceAlt}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header / Progress (Simplified) -->
        <Border Grid.Row="0" Background="{StaticResource BrandSurface}" BorderBrush="{StaticResource BrandBorder}" BorderThickness="0,0,0,1" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="[" Foreground="{StaticResource BrandTextSecondary}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentStep}" Foreground="{StaticResource BrandPrimary}" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="/8] " Foreground="{StaticResource BrandTextSecondary}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StepTitle}" Foreground="{StaticResource BrandTextPrimary}" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Body / Steps -->
        <Border Grid.Row="1" Margin="40" Background="{StaticResource BrandSurface}" CornerRadius="8" Padding="40"
                BorderBrush="{StaticResource BrandBorder}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
            </Border.Effect>
            
            <Grid>
                <!-- Step 1 -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Kế toán nhanh, chính xác, đúng hạn." FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Margin="0,0,0,20"/>
                    <TextBlock Text="Bạn là ai?" FontSize="16" Foreground="{StaticResource BrandTextSecondary}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="3" HorizontalAlignment="Left" Width="600">
                        <Button Style="{StaticResource ProMaxSecondaryButton}" Content="Chủ doanh nghiệp" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ProMaxSecondaryButton}" Content="Kế toán trưởng" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ProMaxSecondaryButton}" Content="Kế toán viên" Margin="0,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
                
                <!-- Step 2 -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Mã số thuế (MST)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="300" Text="{Binding Mst, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Tự động điền" Command="{Binding AutoFillCommand}" Style="{StaticResource ProMaxSecondaryButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding CompanyName}" FontSize="14" Foreground="{StaticResource BrandSuccess}" Margin="0,15,0,0"/>
                </StackPanel>
                
                <!-- Step 3 to 7 Mock -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Chế độ kế toán (Rules)" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Hệ thống tài khoản theo TT 99/2025" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Danh mục (Master Data)" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsStep6, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Số dư đầu kỳ" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsStep7, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Tích hợp Hóa đơn ĐT, Thuế ĐT" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                
                <!-- Step 8 -->
                <StackPanel Visibility="{Binding IsStep8, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Hệ thống sẵn sàng!" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandSuccess}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Style="{StaticResource ProMaxPrimaryButton}" Content="{Binding NextButtonLabel}" Command="{Binding FinishCommand}" Width="200" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BrandSurfaceAlt}" BorderBrush="{StaticResource BrandBorder}" BorderThickness="0,1,0,0" Padding="20">
            <Grid>
                <Button Content="Lưu &#38; làm sau" Style="{StaticResource ProMaxSecondaryButton}" HorizontalAlignment="Left" Foreground="{StaticResource BrandTextSecondary}" BorderThickness="0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Quay lại" Command="{Binding BackCommand}" Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ProMaxSecondaryButton}" Margin="0,0,10,0"/>
                    
                    <Button Content="{Binding NextButtonLabel}" 
                            Command="{Binding NextCommand}" 
                            Visibility="{Binding IsStep8, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Style="{StaticResource ProMaxPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>